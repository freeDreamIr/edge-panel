[Unit]
Description=Edge Panel route manager
After=network.target

[Service]
User=edge-panel
Group=edge-panel
WorkingDirectory=/opt/edge-panel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:15000 --workers 2 --timeout 55 app:app
Restart=on-failure
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
